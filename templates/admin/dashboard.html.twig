{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block content %}
    <div class="alert alert-info mb-4">
        Espace d’administration des rondes et incidents.
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-2">Référentiel</h2>
                    <p class="text-muted">Zones, points de contrôle, équipements.</p>
                    <a class="btn btn-outline-primary btn-sm" href="{{ path('admin_zone_index') }}">Gérer les zones</a>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-2">Exploitation</h2>
                    <p class="text-muted">Rondes, résultats, incidents et priorisation.</p>
                    <a class="btn btn-outline-primary btn-sm" href="{{ path('admin_patrol_round_index') }}">Gérer les rondes</a>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-2">Administration</h2>
                    <p class="text-muted">Comptes utilisateurs et paramètres.</p>
                    <a class="btn btn-outline-primary btn-sm" href="{{ path('admin_user_index') }}">Gérer les utilisateurs</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
